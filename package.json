{
  "name": "aidonecheck",
  "version": "1.0.4",
  "description": "AI says done. AIDoneCheck checks deterministic verification evidence.",
  "type": "module",
  "bin": {
    "aidonecheck": "bin/aidonecheck.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucaswenbo/AIDoneCheck.git"
  },
  "files": [
    "README.zh-CN.md",
    "bin",
    "dist/cli",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser.smoke.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "test:package": "node scripts/package-smoke.mjs",
    "release:check": "node --input-type=module -e \"import {checkVersion} from './scripts/release-policy.mjs'; await checkVersion();\"",
    "license:check": "node scripts/check-license.mjs"
  },
  "devDependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/core": "3.0.1",
    "@types/node": "22.15.30",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "verification",
    "github-action",
    "evidence",
    "codex",
    "claude-code",
    "cursor"
  ],
  "bugs": {
    "url": "https://github.com/lucaswenbo/AIDoneCheck/issues"
  }
}
